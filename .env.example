# Backend
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/hr_ranking_db
DEBUG=false
API_KEY=change-me
SECRET_KEY=change-me
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload and rate limiting
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=50
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_HSTS=false

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
RESEND_API_KEY=
PLATFORM_FROM_EMAIL=TalentLens <notifications@talentlens.app>
PLATFORM_COMPANY_NAME=TalentLens

# Optional LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
GOOGLE_LOCAL_BASE_URL=http://127.0.0.1:8001
LOCAL_LLM_TIMEOUT_SECONDS=45
LOCAL_LLM_DEFAULT_MODEL=
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_EXTRA_MODELS=[]

# Frontend
VITE_API_URL=http://localhost:8000
VITE_API_KEY=change-me

# Hosting
HOST=127.0.0.1
PORT=8000
HF_SPACE_HEALTH_URL=
