# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hr_ranking_db

# Application
DEBUG=false
APP_NAME=TalentLens

# Security (required for production deployments)
API_KEY=change-me-to-a-long-random-secret
SECRET_KEY=change-me-to-another-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_HSTS=true
ENABLE_MOCK_VALIDATION=false
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=50
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Email (optional)
RESEND_API_KEY=
SMTP_SERVER=
SMTP_USERNAME=
SMTP_PASSWORD=

# Cloud LLM keys (server defaults; HRs can also use ephemeral session keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Frontend build-time (Vite)
VITE_API_URL=http://127.0.0.1:8000
VITE_API_KEY=
