# Frontend Dockerfile
FROM node:18 as build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source
COPY . .

# Build
RUN npm run build

# Production image
FROM node:18-slim

WORKDIR /app

# Install serve to run production build
RUN npm install -g serve

# Copy built app from build stage
COPY --from=build /app/dist ./dist
COPY package*.json ./

# Expose port
EXPOSE 5173

# Start app
CMD ["serve", "-s", "dist", "-l", "5173"]
